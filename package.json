{
  "name": "tatkal-high-concurrency-booking",
  "version": "1.0.0",
  "description": "High-concurrency train ticket booking system (TatkalPro) with standalone in-memory GDS adapter and Next.js PWA",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "test": "node scripts/run-all-tests.mjs",
    "test:safetynet": "node frontend/node_modules/jiti/bin/jiti.js tests/safety-net-suite.ts",
    "test:routes": "node frontend/node_modules/jiti/bin/jiti.js scripts/test-routes.ts",
    "test:algorithm": "node frontend/node_modules/jiti/bin/jiti.js scripts/test-split-ticket.ts",
    "load-test": "node frontend/node_modules/jiti/bin/jiti.js scripts/load-test.ts",
    "postinstall": "npm --prefix frontend install"
  },
  "keywords": [
    "irctc",
    "tatkal",
    "nextjs",
    "redis",
    "high-concurrency",
    "dijkstra"
  ],
  "author": "",
  "license": "ISC"
}
