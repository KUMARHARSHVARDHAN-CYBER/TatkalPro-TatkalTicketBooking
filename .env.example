# ==============================================================================
# Tatkal High-Concurrency Booking Engine Configuration
# ==============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL Connection String (Prisma ORM)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&connection_limit=20
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tatkal_db?schema=public&connection_limit=20"

# Redis Connection String (Local Redis or Upstash)
# Example Local: redis://127.0.0.1:6379
# Example Upstash: rediss://default:YOUR_PASSWORD@your-endpoint.upstash.io:6379
REDIS_URL="redis://127.0.0.1:6379"

# Test/Development Mock Flags (Set to "false" when running against live Postgres & Redis)
USE_REDIS_MOCK=false
USE_DB_MOCK=false

