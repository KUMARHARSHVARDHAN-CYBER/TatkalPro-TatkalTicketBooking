{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["./frontend/node_modules/@types", "./node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["tests/**/*", "scripts/**/*", "frontend/lib/**/*"],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "frontend/.next",
    "src",
    "scripts/load-test.ts",
    "scripts/test-split-ticket.ts"
  ]
}
